rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Every user can only read/write their own profile and subcollections
    // (watchlist, watched status, device tokens). No client ever needs to
    // read another user's data for this app.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // The `notified` collection is only read/written by the GitHub Actions
    // notification job via the Firebase Admin SDK, which bypasses these
    // rules entirely. No client access is needed or granted.
  }
}
